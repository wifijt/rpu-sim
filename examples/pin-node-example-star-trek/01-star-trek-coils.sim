# The template built for a Bally Star Trek (-DMACHINE_BALLY_STAR_TREK): the right coil for
# each job, and a game from start to finish.
include machine.sim
run 3000
press SW_CREDIT_RESET
run 3000
expect PN GAME_START
expect SOL fire SOL_DROP_TARGET_RESET
expect SOL fire SOL_OUTHOLE
check switch SW_OUTHOLE open
never SOL fire SOL_LEFT_BUMPER

# each switch fires its own coil
press SW_LEFT_BUMPER
expect SOL fire SOL_LEFT_BUMPER by switch
press SW_CENTER_BUMPER
expect SOL fire SOL_CENTER_BUMPER by switch
press SW_RIGHT_BUMPER
expect SOL fire SOL_RIGHT_BUMPER by switch
press SW_LEFT_SLINGSHOT
expect SOL fire SOL_LEFT_SLINGSHOT by switch
press SW_UPPER_500_TARGET
press SW_LEFT_INNNER_LANE
check fired SOL_LEFT_SLINGSHOT == 1
check fired SOL_CENTER_BUMPER == 1
check score 1 == 410

# the saucer is emptied by the saucer coil, not the outhole kicker
close SW_SAUCER
run 2500
expect SOL fire SOL_SAUCER
check switch SW_SAUCER open
check fired SOL_OUTHOLE == 1

# all four drop targets clear the bank
close SW_DROP_1
close SW_DROP_2
close SW_DROP_3
run 100
close SW_DROP_4
run 1500
expect WAV play 40
expect SOL fire SOL_DROP_TARGET_RESET
check switch SW_DROP_4 open

# three balls to the end of the game
run 30000
close SW_OUTHOLE
run 8000
expect PN BALL_START g=1 slot=1 ball=2
press SW_UPPER_500_TARGET
run 30000
close SW_OUTHOLE
run 8000
press SW_UPPER_500_TARGET
run 30000
close SW_OUTHOLE
run 8000
expect PN GAME_END g=1 endedBy=0

# from the phone: the solenoid test numbers are the coil numbers
run 30000
node action 1 ACT_ENTER_DIAGNOSTICS start
run 50
node action 2 ACT_SOLENOID_TEST start 13
run 100
expect SOL fire SOL_DROP_TARGET_RESET
node action 3 ACT_SOLENOID_TEST start 6
run 100
expect SOL fire SOL_OUTHOLE
check nodelay 0
